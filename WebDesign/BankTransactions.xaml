<Window x:Class="Final.BankTransactions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank Transactions" Height="600" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Trip Picker and Account Picker -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Select Trip:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="TripComboBox" 
                      Width="200" 
                      Margin="0,0,20,0" 
                      DisplayMemberPath="Destination"
                      SelectedValuePath="TripId"
                      SelectionChanged="TripComboBox_SelectionChanged"/>

            <TextBlock Text="Select Account:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="AccountComboBox" Width="200" Margin="0,0,20,0" />

            <Button Content="Fetch Transactions" Click="FetchTransactions_Click"/>
        </StackPanel>

        <!-- Transactions List -->
        <ListView x:Name="TransactionsListView" Grid.Row="1" Margin="0,0,0,10" SelectionChanged="TransactionsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" Width="100"/>
                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="300"/>
                    <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding Amount}" Width="100"/>
                    <GridViewColumn Header="Actions" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" 
                                Background="Red" 
                                Foreground="White"
                                Click="DeleteTransaction_Click"
                                Tag="{Binding Description}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>


        <!-- Manual Add Transaction Section -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Bottom">
            <TextBlock Text="Manually Add Transaction" FontWeight="Bold" Margin="0,10,0,5"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Date:" VerticalAlignment="Center"/>
                <DatePicker x:Name="ManualDatePicker" Width="150" Margin="5,0,20,0"/>
                <TextBlock Text="Description:" VerticalAlignment="Center"/>
                <TextBox x:Name="ManualDescriptionTextBox" Width="200" Margin="5,0,20,0"/>
                <TextBlock Text="Amount:" VerticalAlignment="Center"/>
                <TextBox x:Name="ManualAmountTextBox" Width="100" Margin="5,0,20,0"/>
                <Button Content="Add" Click="AddManualTransaction_Click"/>
                <Button Content="Edit" Click="EditTransaction_Click" Margin="5,0,20,0"/>
            </StackPanel>

            <Button Content="Fetch Transactions" Click="FetchTransactions_Click"/>
            
        </StackPanel>
    </Grid>
</Window>
