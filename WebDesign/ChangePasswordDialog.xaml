<Window x:Class="Final.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="300" Width="400" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Change Password" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Current Password:"/>
        <PasswordBox x:Name="CurrentPasswordBox" Margin="0,5,0,15"/>

        <TextBlock Text="New Password:"/>
        <PasswordBox x:Name="NewPasswordBox" Margin="0,5,0,15"/>

        <TextBlock Text="Confirm New Password:"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,5,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="Change" Click="Change_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
