<Window x:Class="Final.AddTrips"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Trip" Height="600" Width="900" Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="White" Grid.Column="0" VerticalAlignment="Stretch">
            <TextBlock Text="Menu " FontSize="20" FontWeight="Bold" Margin="10"/>
            <Button Content="👤 My Account" Margin="10" HorizontalAlignment="Left" Click="MyAccount_Click"/>
            <Button Content="✈️ Trips" Margin="10" HorizontalAlignment="Left" Click="Trips_Click"/>
            <Button Content="💵 Finance" Margin="10" HorizontalAlignment="Left" Click="Finance_Click"/>
            <Button Content="💳 My Documents" Margin="10" HorizontalAlignment="Left" Click="Documents_Click"/>
            <Button Content="📊 Dashboarding" Margin="10" HorizontalAlignment="Left" Click="Dashboarding_Click"/>
            <StackPanel>
                <Button Content=" Settings" Margin="5" Click="Settings_Click"/>
                <Button Content="🔙 Log out" Margin="5" Click="Logout_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="30">
            <TextBlock Text="New Trip" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Select a destination:" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ComboBox x:Name="DestinationComboBox"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          Width="300"
                          Height="30"
                          PreviewKeyUp="DestinationComboBox_PreviewKeyUp"
                          DisplayMemberPath="CityName" />
                <Button x:Name="ActivitiesSuggestionsButton"
                        Content="Activities suggestions"
                        Width="170" Height="30"
                        Background="#6CA8FF" Foreground="White" Margin="10,0,0,0"
                        Click="ActivitiesSuggestionsButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Start Date:" FontWeight="Bold"/>
                    <DatePicker x:Name="StartDatePicker" Width="150"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="End Date:" FontWeight="Bold"/>
                    <DatePicker x:Name="EndDatePicker" Width="150"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Budget (euro):" FontWeight="Bold"/>
            <TextBox x:Name="BudgetTextBox" Width="150" Height="30" Margin="0,0,0,20" HorizontalAlignment="Left"/>

            <TextBlock Text="List of items to take:" FontWeight="Bold"/>
            <TextBox x:Name="ItemsTextBox" Height="100" Width="400" HorizontalAlignment="Left" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

            <TextBlock Text="List of activities:" FontWeight="Bold"/>
            <TextBox x:Name="ActivitiesTextBox" Height="100" Width="400" HorizontalAlignment="Left" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
                <Button Content="Save changes" Width="150" Height="40" Background="Black" Foreground="White" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>