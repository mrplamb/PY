<Window x:Class="Final.Personal_info"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Account" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#f0f0f3" Grid.Column="0" VerticalAlignment="Stretch">
            <TextBlock Text="Menu" FontSize="20" FontWeight="Bold" Margin="10"/>
            <Button Content="🏠 My Account" Margin="10" HorizontalAlignment="Left" Click="MyAccount_Click"/>
            <Button Content="✈️ Trips" Margin="10" HorizontalAlignment="Left" Click="Trips_Click"/>
            <Button Content="💵 Finance" Margin="10" HorizontalAlignment="Left" Click="Finance_Click"/>
            <Button Content="💳 My Documents" Margin="10" HorizontalAlignment="Left" Click="Documents_Click"/>
            <Button Content="📊 Dashboarding" Margin="10" HorizontalAlignment="Left" Click="Dashboarding_Click"/>
            <StackPanel>
                <Button Content=" Settings" Margin="5"/>
                <Button Content="🔙 Log out" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="20">
            <StackPanel>
                <Button Content="Back to Home" Click="BackToHome_Click" HorizontalAlignment="Left" Margin="0,30,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="30" Height="30">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="HeaderProfileImage" ImageSource="pack://application:,,,/Final;component/Views/Profile_picture.jpeg"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="HeaderUserNameTextBlock" Text="Yasmine Bouanane" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="My account" FontSize="20" FontWeight="Bold" Margin="0,20,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <Button Content="👤 Personal Info" Margin="5" FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
                    <Button Content="🔒 Password and Security" Margin="5" Background="Transparent" BorderThickness="0"/>
                    <Button Content="🔔 Notification" Margin="5" Background="Transparent" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,20" VerticalAlignment="Center">
                    <Grid Width="100" Height="100" Margin="0,0,10,0">
                        <Ellipse Width="100" Height="100" Fill="LightGray"/>
                        <Image x:Name="ProfilePictureImage" Width="100" Height="100" Stretch="UniformToFill" ClipToBounds="True">
                            <Image.Clip>
                                <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="Upload New Photo" Click="UploadPhotoButton_Click" Margin="0,0,0,5" Padding="5"/>
                        <Button Content="Delete Photo" Click="DeletePhotoButton_Click" Padding="5"/>
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,5" Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Full name"/>
                        <TextBox x:Name="FullNameTextBox" Height="30" />
                    </StackPanel>

                    <StackPanel Margin="10,5" Grid.Column="1" Grid.Row="0">
                        <TextBlock Text="Date of Birth"/>
                        <DatePicker x:Name="DobDatePicker" Height="30" />
                    </StackPanel>

                    <StackPanel Margin="0,5" Grid.ColumnSpan="2" Grid.Row="1">
                        <TextBlock Text="Gender"/>
                        <ComboBox x:Name="GenderComboBox" Height="30">
                            <ComboBoxItem Content="Female"/>
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,5" Grid.ColumnSpan="2" Grid.Row="2">
                        <TextBlock Text="Email address"/>
                        <TextBox x:Name="EmailTextBox" Height="30" IsReadOnly="True" Background="#EEEEEE" BorderBrush="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel Margin="0,5" Grid.ColumnSpan="2" Grid.Row="3">
                        <TextBlock Text="Phone number"/>
                        <TextBox x:Name="PhoneTextBox" Height="30" />
                    </StackPanel>

                    <StackPanel Margin="0,5" Grid.ColumnSpan="2" Grid.Row="4">
                        <TextBlock Text="Address"/>
                        <TextBox x:Name="AddressTextBox" Height="30" />
                    </StackPanel>
                </Grid>

                <Button Content="Save changes"
                        Click="SaveButton_Click"
                        Background="#2D2D33" Foreground="White" FontWeight="Bold" Height="40"
                        HorizontalAlignment="Left" Margin="0,30,0,0" Width="150"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>