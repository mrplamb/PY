<Window x:Class="Final.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PY Travel - Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#EEEEEE">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#2D2D33">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Margin="20">
                <Border Height="200" Width="200">
                    <Border.Background>
                        <ImageBrush ImageSource="Views/Image.jpeg" Stretch="Fill"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="PY Travel"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,20,0,5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="All your trips, documents, budgets in one place."
                           Foreground="White"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="#EEEEEE">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="Log in" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />

                <TextBlock Text="Email address" FontWeight="Bold" Margin="0,10,0,5" />
                <TextBox x:Name="EmailTextBox" Height="30" />

                <TextBlock Text="Password" FontWeight="Bold" Margin="0,10,0,5" />
                <PasswordBox x:Name="PasswordBox" Height="30" />

                <Button Content="Log in"
                        Background="Black"
                        Foreground="White"
                        Margin="0,20,0,10"
                        Height="35"
                        Click="Login_Click" />

                <Button Content="Create an account"
                        
                    Foreground="Black"
                        Margin="0,5,0,0"
                        Height="35"
                        Click="CreateAccount_Click" />

                    <TextBlock Text="Forgot your password?"
                           Foreground="Gray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0" />
            </StackPanel>
        </Grid>

        <Border Background="#CCCCCC" Width="50" Height="50" CornerRadius="10"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
            <Image Source="Views/App_logo.png" Stretch="Uniform"/>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   TextDecorations="Underline"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Blue"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>