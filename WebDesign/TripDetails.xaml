<Window x:Class="Final.TripDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trip Details" Height="400" Width="600">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Trip Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock x:Name="DestinationTextBlock" Margin="0,5"/>
            <TextBlock x:Name="DatesTextBlock" Margin="0,5"/>
            <TextBlock x:Name="BudgetTextBlock" Margin="0,5"/>
            <TextBlock x:Name="StatusTextBlock" Margin="0,5"/>
            <TextBlock x:Name="ActivitiesTextBlock" Margin="0,5"/>
            <TextBlock x:Name="ItemsTextBlock" Margin="0,5"/>
            <Button Content="Close" Width="100" Margin="0,20,0,0" HorizontalAlignment="Left" Click="CloseButton_Click"/>
            <Button Content="Delete" Width="100" Margin="0,10,0,0" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
