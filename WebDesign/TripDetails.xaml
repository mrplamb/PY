<Window x:Class="Final.TripDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Trip Details" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3498DB"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2980B9"/>
        <SolidColorBrush x:Key="DarkText" Color="#333333"/>
        <SolidColorBrush x:Key="LightText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#F5F8FA"/>
        <SolidColorBrush x:Key="MenuBackground" Color="#2C3E50"/>
        <SolidColorBrush x:Key="OrangeAccent" Color="#E67E22"/>
        <SolidColorBrush x:Key="RedAccent" Color="#E74C3C"/>

        <Style TargetType="Button" x:Key="SquareButtonStyle">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource LightText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Direction="270" Color="#BBBBBB" Opacity="0.6" BlurRadius="5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="3" Direction="270" Color="#AAAAAA" Opacity="0.8" BlurRadius="8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkText}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" Color="Transparent"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PanelBackground}" Margin="0">
        <Border Background="White" CornerRadius="8" Margin="20" Padding="30">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" Direction="270" Color="#CCCCCC" Opacity="0.6" BlurRadius="10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Trip Details" FontSize="24" FontWeight="ExtraBold" Margin="0,0,0,20" Foreground="{StaticResource DarkText}"/>

                <TextBlock x:Name="DestinationTextBlock" Margin="0,8" FontSize="16" Foreground="{StaticResource DarkText}"/>
                <TextBlock x:Name="DatesTextBlock" Margin="0,8" FontSize="16" Foreground="{StaticResource DarkText}"/>
                <TextBlock x:Name="BudgetTextBlock" Margin="0,8" FontSize="16" Foreground="{StaticResource DarkText}"/>
                <TextBlock x:Name="StatusTextBlock" Margin="0,8" FontSize="16" Foreground="{StaticResource DarkText}"/>
                <TextBlock x:Name="ActivitiesTextBlock" Margin="0,8" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource DarkText}"/>
                <TextBlock x:Name="ItemsTextBlock" Margin="0,8" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource DarkText}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                    <Button Content="Close" Width="100" Margin="0,0,10,0" HorizontalAlignment="Right" Click="CloseButton_Click"
                            Style="{StaticResource SquareButtonStyle}" Background="{StaticResource AccentBlue}"/>
                    <Button Content="Delete" Width="100" HorizontalAlignment="Right" Click="DeleteButton_Click"
                            Style="{StaticResource SquareButtonStyle}" Background="{StaticResource RedAccent}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>