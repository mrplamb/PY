<Window x:Class="Final.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pay with PayPal"
        Height="650" Width="600"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Main Container -->
        <Border CornerRadius="10" Background="White" Padding="30" Margin="50">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Complete Your Payment" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20" TextAlignment="Center"/>

                <TextBlock Text="Select Trip:" FontWeight="Bold" Margin="0,20,0,5"/>
                <ComboBox x:Name="TripComboBox" Width="300" Height="30" Margin="0,0,0,10"
                      DisplayMemberPath="Destination"
                      SelectedValuePath="TripId"
                      SelectedIndex="0"/>


                <TextBlock Text="Amount to pay (€):" Margin="0,0,0,5"/>
                <TextBox x:Name="AmountTextBox" Width="200" Height="30" Margin="0,0,0,20" HorizontalAlignment="Center" />

                <Button Content="Pay with PayPal"
                Background="#FFC439"
                Foreground="Black"
                FontWeight="Bold"
                Width="200"
                Height="40"
                HorizontalAlignment="Center"
                Click="PayWithPayPal_Click"/>

                <Button Content="Capture Payment"
                Background="#6CA8FF"
                Foreground="White"
                FontWeight="Bold"
                Width="150"
                Height="20"
                Margin="0,8,0,0"
                Click="CapturePayment_Click"/>


                <TextBlock x:Name="CaptureResultTextBlock"
               FontSize="14"
               Margin="0,10,0,0"
               Foreground="Gray"/>



                <Button Content="Back" Width="100" Margin="0,20,0,0" Click="BackButton_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
