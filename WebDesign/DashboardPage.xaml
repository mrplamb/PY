<Window x:Class="Final.DashboardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Final"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Dashboard" Height="700" Width="1200" MinHeight="600" MinWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="10,5,10,10" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Total Trips:" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OverallTotalTripsTextBlock" Text="0" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Total Expenses Across Trips:" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OverallTotalExpensesTextBlock" Text="C0.00" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Highest Spent Trip:" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OverallHighestSpentTripTextBlock" Text="N/A" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Margin="10,0,10,10" Padding="10">
                <StackPanel>
                    <TextBlock Text="My Trips" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>


                    <ListView x:Name="TripsListView" Height="200" Margin="0,10,0,10" SelectionChanged="TripsListView_SelectionChanged"
                              ItemsSource="{Binding TripsSummary}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Trip Name" DisplayMemberBinding="{Binding Destination}" Width="150"/>
                                <GridViewColumn Header="Dates" DisplayMemberBinding="{Binding DatesRange}" Width="150"/>
                                <GridViewColumn Header="Total Spent" DisplayMemberBinding="{Binding TotalSpentFormatted}" Width="100"/>
                                <GridViewColumn Header="Budget" DisplayMemberBinding="{Binding BudgetFormatted}" Width="80"/>
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SelectedTripNameTextBlock" Grid.Row="0"
                           Text="Select a Trip for Details" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,1" Margin="5" Padding="5">
                        <StackPanel>
                            <TextBlock Text="Expenses by Category" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <lvc:PieChart x:Name="ExpensePieChart"
                                          Height="200"
                                          LegendLocation="Right"
                                          InnerRadius="0"
                                          Series="{Binding CategorySeries}"
                                          DataClick="ExpensePieChart_DataClick"
                                          >
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip BulletSize="20"/>
                                </lvc:PieChart.DataTooltip>
                                <lvc:PieChart.ChartLegend>
                                    <lvc:DefaultLegend BulletSize="20"/>
                                </lvc:PieChart.ChartLegend>
                            </lvc:PieChart>
                            <TextBlock x:Name="SelectedTripTotalExpensesTextBlock"
                                       Text="Total for Trip: C0.00"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="5" Padding="5">
                        <StackPanel>
                            <TextBlock Text="Expenses Over Time" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <lvc:CartesianChart x:Name="ExpensesLineChart" Series="{Binding ExpenseOverTimeSeries}" Height="200">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Date" Labels="{Binding Labels}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Amount Spent" LabelFormatter="{Binding Formatter}"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Margin="5" Padding="5">
                        <StackPanel>
                            <TextBlock Text="Budget vs. Actual" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <lvc:PieChart x:Name="BudgetDonutChart"
                                          Height="200"
                                          LegendLocation="Right"
                                          InnerRadius="70"
                                          Series="{Binding BudgetSeries}"
                                          >
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip BulletSize="20"/>
                                </lvc:PieChart.DataTooltip>
                                <lvc:PieChart.ChartLegend>
                                    <lvc:DefaultLegend BulletSize="20"/>
                                </lvc:PieChart.ChartLegend>
                            </lvc:PieChart>
                        </StackPanel>
                    </Border>


                </Grid>

                <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="10,10,10,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Top Expenses / Transactions" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListView x:Name="TopExpensesListView" Height="150" ItemsSource="{Binding TopExpenses}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:d}'}" Width="80"/>
                                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="200"/>
                                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="100"/>
                                    <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding Amount, StringFormat='{}{0:C2}'}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>