<Window x:Class="Final.UploadDocumentPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Documents" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Menu -->
        <StackPanel Background="White" Grid.Column="0" VerticalAlignment="Stretch">
            <TextBlock Text="Menu " FontSize="20" FontWeight="Bold" Margin="10"/>
            <Button Content="👤 My Account" Margin="10" HorizontalAlignment="Left" Click="MyAccount_Click"/>
            <Button Content="✈️ Trips" Margin="10" HorizontalAlignment="Left" Click="Trips_Click"/>
            <Button Content="💵 Finance" Margin="10" HorizontalAlignment="Left" Click="Finance_Click"/>
            <Button Content="💳 My Documents" Margin="10" HorizontalAlignment="Left" Click="Documents_Click"/>
            <Button Content="📊 Dashboarding" Margin="10" HorizontalAlignment="Left" Click="Dashboarding_Click"/>
            <StackPanel>
                <Button Content=" Settings" Margin="5"/>
                <Button Content="🔙 Log out" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content -->
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Text="My Documents" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="All Documents" Margin="0,10,0,20" FontSize="16"/>
            <StackPanel Orientation="Horizontal" Height="67" RenderTransformOrigin="0.505,0.496">
                <TextBox x:Name="NewDocumentTextBox" Width="200" Height="30" Margin="0,0,10,0" />
                <Button Content="Add Document" Width="120" Height="30" Click="AddDocument_Click"/>
            </StackPanel>

            <!-- Add New Document -->

            <!-- Dynamic Document Buttons -->
            <StackPanel x:Name="DocumentsPanel" VerticalAlignment="Top" />
        </StackPanel>
    </Grid>
</Window>
