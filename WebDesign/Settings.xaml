<Window x:Class="Final.Settings"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Settings" Height="600" Width="800">
    <StackPanel Margin="20">

        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Button Content="Change Password" Margin="0,5" Click="ChangePassword_Click"/>
        <Button Content="Delete Account" Margin="0,5" Click="DeleteAccount_Click"/>
        <Button Content="Update Profile Picture" Margin="0,5" Click="UpdateProfilePicture_Click"/>
        <Button Content="Update Personal Info" Margin="0,5" Click="UpdatePersonalInfo_Click"/>
        <Button Content="Notification Preferences" Margin="0,5" Click="NotificationPreferences_Click"/>
        <Button Content="Appearance / Theme" Margin="0,5" Click="Appearance_Click"/>
        <Button Content="Linked Payment Methods" Margin="0,5" Click="PaymentMethods_Click"/>
        <Button Content="Language and Currency" Margin="0,5" Click="LanguageCurrency_Click"/>
    </StackPanel>
</Window>

 