<Window x:Class="Final.CityActivitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Activities and Restaurants" Height="600" Width="400">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HyperlinkTextBlockStyle">
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Foreground" Value="Blue"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="CityNameTextBlock" Text="Activities for [City Name]" FontSize="20" FontWeight="Bold" Margin="15,15,15,5" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" Margin="15,0,15,10">
            <StackPanel>
                <TextBlock Text="Places to Visit:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ItemsControl x:Name="PlacesToVisitList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}"
                                                   MouseLeftButtonUp="LinkTextBlock_MouseLeftButtonUp"
                                                   Tag="{Binding WebsiteLink}">
                                            <Run Text="More Info"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" Margin="15,0,15,15">
            <StackPanel>
                <TextBlock Text="Places to Eat:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ItemsControl x:Name="PlacesToEatList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}"
                                                   MouseLeftButtonUp="LinkTextBlock_MouseLeftButtonUp"
                                                   Tag="{Binding WebsiteLink}">
                                            <Run Text="More Info"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>