<Window x:Class="Final.BankInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3498DB"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2980B9"/>
        <SolidColorBrush x:Key="DarkText" Color="#333333"/>
        <SolidColorBrush x:Key="LightText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#F5F8FA"/>
        <SolidColorBrush x:Key="MenuBackground" Color="#2C3E50"/>
        <SolidColorBrush x:Key="OrangeAccent" Color="#E67E22"/>

        <Style TargetType="Button" x:Key="SquareButtonStyle">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource LightText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Direction="270" Color="#BBBBBB" Opacity="0.6" BlurRadius="5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="3" Direction="270" Color="#AAAAAA" Opacity="0.8" BlurRadius="8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkText}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" Color="Transparent"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="MenuButtonStyle" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LightText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" HorizontalAlignment="Left" Margin="0"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                    <Setter Property="Foreground" Value="{StaticResource LightText}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrangeAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PanelBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource MenuBackground}"
                BorderThickness="0,0,1,0" BorderBrush="#333333">
            <StackPanel VerticalAlignment="Stretch">
                <TextBlock Text="Menu " FontSize="22" FontWeight="Bold" Margin="20,20,10,10" Foreground="{StaticResource LightText}"/>
                <Button Content="👤 My Account" Style="{StaticResource MenuButtonStyle}" Click="MyAccount_Click"/>
                <Button Content="✈️ Trips" Style="{StaticResource MenuButtonStyle}" Click="Trips_Click"/>
                <Button Content="💵 Finance" Style="{StaticResource MenuButtonStyle}" Click="Finance_Click"/>
                <Button Content="💳 My Documents" Style="{StaticResource MenuButtonStyle}" Click="Documents_Click"/>
                <Button Content="📊 Dashboarding" Style="{StaticResource MenuButtonStyle}" Click="Dashboarding_Click"/>
                <Border Height="1" Background="#555555" Margin="10,10"/>
                <Button Content="⚙️ Settings" Style="{StaticResource MenuButtonStyle}" Click="Settings_Click"/>
                <Button Content="🔙 Log out" Style="{StaticResource MenuButtonStyle}" Click="Button_Click_1"/>
            </StackPanel>
        </Border>
        
        

        <Border Grid.Column="1" Background="{StaticResource PanelBackground}" Margin="30">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" Direction="270" Color="#CCCCCC" Opacity="0.5" BlurRadius="10"/>
            </Border.Effect>
            
            
            
            <StackPanel Margin="30">
                <TextBlock Text="Finance Details" FontSize="28" FontWeight="ExtraBold" Margin="0,0,0,15" Foreground="{StaticResource DarkText}"/>
                <TextBlock Text="Please provide your bank information below." FontSize="14" Foreground="Gray" Margin="0,0,0,25"/>
                
                

                <StackPanel>
                    
                    <TextBlock Text="Full Name" Foreground="{StaticResource DarkText}"/>
                    <TextBox x:Name="FullNameTextBox" Margin="0,0,0,15" TextChanged="FullNameTextBox_TextChanged"/>

                    <TextBlock Text="IBAN" Foreground="{StaticResource DarkText}"/>
                    <TextBox x:Name="IbanTextBox" Margin="0,0,0,15" TextChanged="IbanTextBox_TextChanged"/>

                    <TextBlock Text="BIC" Foreground="{StaticResource DarkText}"/>
                    <TextBox x:Name="BicTextBox" Margin="0,0,0,15" TextChanged="BicTextBox_TextChanged"/>

                    <TextBlock Text="Bank Name" Foreground="{StaticResource DarkText}"/>
                    <TextBox x:Name="BankNameTextBox" Margin="0,0,0,25" TextChanged="BankNameTextBox_TextChanged"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Details" Style="{StaticResource SquareButtonStyle}"
                                HorizontalAlignment="Left" Width="150" Margin="0,0,15,0" Click="SaveButton_Click"/>
                        <Button Content="💳 Pay Now" Style="{StaticResource SquareButtonStyle}"
                                Background="{StaticResource OrangeAccent}" Foreground="{StaticResource LightText}"
                                Width="150" Click="PayNow_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

     
    </Grid>
</Window>